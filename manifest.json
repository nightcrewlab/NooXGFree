{
  "manifest_version": 3,
  "name": "NooXGFree",
  "version": "2.2.0",
  "description": "Epic Games, Steam ve Fab.com'daki bedava içerikleri takip edin. Developed by NooXRii",
  "author": "NooXRii",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://store.steampowered.com/*",
    "https://store.epicgames.com/*",
    "https://store-site-backend-static.ak.epicgames.com/*",
    "https://www.fab.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}